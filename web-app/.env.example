NODE_ENV=development

# Database
# - ホストで pnpm run dev / pnpm run build する場合: この値が使われます（ホスト名は localhost）
# - Docker Compose で web コンテナを起動する場合: compose.yml の DATABASE_URL 環境変数で上書きされます（コンテナ間接続のホスト名は db）
DATABASE_URL=postgresql://user:password@localhost:5432/dailygreen

# Better Auth (32+ chars). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth
# リダイレクトURI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google One Tap ボタン（ブラウザ用）。GOOGLE_CLIENT_ID と同じ値を設定
VITE_GOOGLE_CLIENT_ID=

# Web Push
# pnpm exec web-push generate-vapid-keys で1組だけ生成し、本番では永続的に同じkey pairを使用する。
# PUBLIC_KEYだけはクライアントへ公開してよい。PRIVATE_KEYはserver-only。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 例: mailto:admin@example.com または https://example.com
VAPID_SUBJECT=

# notification-scheduler -> web の内部job認証用。32文字以上のランダム値を使用する。
# 例: openssl rand -base64 32
INTERNAL_JOB_TOKEN=

# デプロイしたcommit SHAまたはイメージタグ
APP_VERSION=development
